<?xml version="1.0"?>

<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"
?>

<package format="3">

  <name>hand_commander</name>

  <version>0.0.0</version>

  <description>
    ROS 2 commander node for the robot hand using MoveIt.
  </description>

  <maintainer email="iddy@todo.todo">
    iddy
  </maintainer>

  <license>Apache-2.0</license>


  <!-- Build system -->

  <buildtool_depend>
    ament_cmake
  </buildtool_depend>


  <!-- ROS 2 -->

  <depend>
    rclcpp
  </depend>


  <!-- MoveIt -->

  <depend>
    moveit_ros_planning_interface
  </depend>


  <!-- Messages -->

  <depend>
    example_interfaces
  </depend>

  <depend>
    geometry_msgs
  </depend>


  <!-- TF2 -->

  <depend>
    tf2
  </depend>


  <!-- Custom interfaces -->

  <depend>
    hand_interfaces
  </depend>


  <!-- Testing -->

  <test_depend>
    ament_lint_auto
  </test_depend>

  <test_depend>
    ament_lint_common
  </test_depend>


  <export>

    <build_type>
      ament_cmake
    </build_type>

  </export>

</package>