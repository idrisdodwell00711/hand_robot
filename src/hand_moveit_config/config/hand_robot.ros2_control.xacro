<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="hand_robot_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- By default, set up controllers for simulation. This won't work on real hardware -->
                <plugin>mock_components/GenericSystem</plugin>
            </hardware>
            <joint name="base_to_base_thumb">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['base_to_base_thumb']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="thumb_base_to_middle">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['thumb_base_to_middle']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="base_to_base_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['base_to_base_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="base_to_middle_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['base_to_middle_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="middle_to_tip_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['middle_to_tip_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="base_to_base_2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['base_to_base_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="base_to_middle_2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['base_to_middle_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="middle_to_tip_2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['middle_to_tip_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="base_to_base_3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['base_to_base_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="base_to_middle_3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['base_to_middle_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="middle_to_tip_3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['middle_to_tip_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="base_to_base_4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['base_to_base_4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="base_to_middle_4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['base_to_middle_4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="middle_to_tip_4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['middle_to_tip_4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
